# Sunder & Co. Environment Variables
# Copy this file to .env and fill in your values

# Site Configuration
VITE_SITE_URL=https://sunder.co
VITE_SITE_NAME="Sunder & Co."

# Analytics (optional)
VITE_GA_ID=
VITE_HOTJAR_ID=

# Contact Form (if using external service)
VITE_FORM_ENDPOINT=

# 3D Model CDN (if hosting GLTF files externally)
VITE_MODEL_CDN=

# AI / Agent Configuration (for future use)
VITE_AGENT_ENDPOINT=
